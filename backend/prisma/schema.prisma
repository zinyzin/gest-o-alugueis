// Schema do banco — Gestão Financeira de Imóvel Alugado
// Ver docs/modelo-dados.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  VISUALIZADOR
}

enum FormaPagamento {
  PIX
  BOLETO
  TRANSFERENCIA
  DINHEIRO
  CARTAO
}

enum StatusReceita {
  PAGO
  ATRASADO
  PENDENTE
}

enum IndiceReajuste {
  IGPM
  IPCA
  INPC
  OUTRO
}

enum CategoriaDespesa {
  AGUA
  LUZ
  IPTU
  CONDOMINIO
  MANUTENCAO
  REFORMA
  IMPOSTOS
  OUTRO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil   @default(VISUALIZADOR)
  criadoEm  DateTime @default(now()) @map("criado_em")

  imoveis  UsuarioImovel[]
  leituras NotificacaoLeitura[]
  convites Convite[]

  @@map("usuarios")
}

// Link de convite para criar conta: prazo curto e uso único. Guarda só o hash do token.
// Sem criador = gerado pelo terminal (primeira conta).
model Convite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @map("token_hash")
  criadoPorId String?   @map("criado_por_id")
  expiraEm    DateTime  @map("expira_em")
  usadoEm     DateTime? @map("usado_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  criadoPor Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)

  @@map("convites")
}

// Acesso multiusuário: N usuários <-> N imóveis
model UsuarioImovel {
  usuarioId String @map("usuario_id")
  imovelId  String @map("imovel_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  imovel  Imovel  @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@id([usuarioId, imovelId])
  @@map("usuarios_imoveis")
}

model Imovel {
  id        String   @id @default(cuid())
  endereco  String
  descricao String?
  fotos     String[]
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuarios     UsuarioImovel[]
  inquilinos   Inquilino[]
  contratos    Contrato[]
  receitas     Receita[]
  despesas     Despesa[]
  notificacoes Notificacao[]

  @@map("imoveis")
}

model Inquilino {
  id       String  @id @default(cuid())
  imovelId String  @map("imovel_id")
  nome     String
  cpfCnpj  String? @map("cpf_cnpj")
  telefone String?
  email    String?

  imovel    Imovel     @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  contratos Contrato[]
  receitas  Receita[]

  @@map("inquilinos")
}

model Contrato {
  id                 String         @id @default(cuid())
  imovelId           String         @map("imovel_id")
  inquilinoId        String         @map("inquilino_id")
  dataInicio         DateTime       @map("data_inicio")
  dataFim            DateTime?      @map("data_fim")
  valorAluguel       Decimal        @map("valor_aluguel") @db.Decimal(12, 2)
  diaVencimento      Int            @map("dia_vencimento")
  indiceReajuste     IndiceReajuste @default(IGPM) @map("indice_reajuste")
  dataUltimoReajuste DateTime?      @map("data_ultimo_reajuste")
  valorCaucao        Decimal?       @map("valor_caucao") @db.Decimal(12, 2)
  anexoUrl           String?        @map("anexo_url")
  criadoEm           DateTime       @default(now()) @map("criado_em")

  imovel       Imovel        @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  inquilino    Inquilino     @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  receitas     Receita[]
  notificacoes Notificacao[]

  @@map("contratos")
}

model Receita {
  id              String         @id @default(cuid())
  imovelId        String         @map("imovel_id")
  inquilinoId     String?        @map("inquilino_id")
  dataRecebimento DateTime       @map("data_recebimento")
  descricao       String
  valor           Decimal        @db.Decimal(12, 2)
  formaPagamento  FormaPagamento @map("forma_pagamento")
  status          StatusReceita  @default(PENDENTE)
  // Preenchidos quando a receita é o aluguel gerado automaticamente pelo contrato.
  contratoId      String?        @map("contrato_id")
  competencia     String? // mês de referência, "AAAA-MM"
  criadoEm        DateTime       @default(now()) @map("criado_em")

  imovel    Imovel     @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  inquilino Inquilino? @relation(fields: [inquilinoId], references: [id], onDelete: SetNull)
  contrato  Contrato?  @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  // Um aluguel por contrato e mês: a rotina diária pode rodar várias vezes sem duplicar.
  @@unique([contratoId, competencia])
  @@map("receitas")
}

model Despesa {
  id             String           @id @default(cuid())
  imovelId       String           @map("imovel_id")
  dataPagamento  DateTime         @map("data_pagamento")
  categoria      CategoriaDespesa
  descricao      String
  fornecedor     String?
  valor          Decimal          @db.Decimal(12, 2)
  formaPagamento FormaPagamento   @map("forma_pagamento")
  comprovanteUrl String?          @map("comprovante_url")
  criadoEm       DateTime         @default(now()) @map("criado_em")

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("despesas")
}

enum TipoNotificacao {
  ALUGUEL_ATRASADO
  REAJUSTE
  CONTRATO_VENCENDO
}

// Avisos gerados pelas rotinas, visíveis a todos com acesso ao imóvel.
model Notificacao {
  id         String          @id @default(cuid())
  imovelId   String          @map("imovel_id")
  contratoId String?         @map("contrato_id")
  tipo       TipoNotificacao
  titulo     String
  mensagem   String
  // Identifica o fato avisado (ex.: "reajuste:<contrato>:2027-01") para não repetir o aviso.
  chave      String          @unique
  criadoEm   DateTime        @default(now()) @map("criado_em")

  imovel   Imovel               @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  contrato Contrato?            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  leituras NotificacaoLeitura[]

  @@index([imovelId, criadoEm])
  @@map("notificacoes")
}

// Quem já leu cada aviso (a leitura é por pessoa).
model NotificacaoLeitura {
  usuarioId     String   @map("usuario_id")
  notificacaoId String   @map("notificacao_id")
  lidaEm        DateTime @default(now()) @map("lida_em")

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  notificacao Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, notificacaoId])
  @@map("notificacoes_leituras")
}
